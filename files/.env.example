# Stable SPTushonka release tag published to ghcr.io/sp-tushonka/server-csharp.
SPT_VERSION=4.1.5
# Multi-architecture manifest digest for the exact SPT image above.
SPT_DIGEST=sha256:efd9ae3406b0b49769475828c393edffdc32f5df12e3bf130d7f446607a33ded

# Released Fika Server C# version. Do not include the leading "v".
FIKA_VERSION=2.4.0

# Match these to the owner of ./spt-user so the container does not leave root-owned files.
PUID=1000
PGID=1000

# Host port mapped to the SPT HTTP server.
HOST_PORT=6969

# Directory, relative to this file, where update.sh stores full user-volume backups.
BACKUP_DIR=backups
